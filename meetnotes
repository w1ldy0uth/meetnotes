#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV_DIR="$ROOT_DIR/venv"
PYTHON_BIN="$VENV_DIR/bin/python"
PIP_BIN="$VENV_DIR/bin/pip"
REQUIREMENTS="$ROOT_DIR/requirements.txt"
INSTALL_MARKER="$VENV_DIR/.requirements-installed"

create_venv() {
  echo "Creating virtual environment at $VENV_DIR"
  python3 -m venv "$VENV_DIR"
}

if [[ ! -x "$PYTHON_BIN" || ! -x "$PIP_BIN" ]]; then
  create_venv
elif ! "$PYTHON_BIN" --version >/dev/null 2>&1 || ! "$PIP_BIN" --version >/dev/null 2>&1; then
  echo "Recreating broken virtual environment at $VENV_DIR"
  rm -rf "$VENV_DIR"
  create_venv
fi

if [[ -f "$REQUIREMENTS" ]]; then
  if [[ ! -f "$INSTALL_MARKER" || "$REQUIREMENTS" -nt "$INSTALL_MARKER" ]]; then
    echo "Installing dependencies from requirements.txt"
    "$PIP_BIN" install -r "$REQUIREMENTS"
    touch "$INSTALL_MARKER"
  fi
fi

exec "$PYTHON_BIN" "$ROOT_DIR/meetnotes.py" "$@"
